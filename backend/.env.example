PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CACHE_TTL_SECONDS=3600
CF_API_BASE=https://codeforces.com/api
# Production: set this to the deployed alfa-leetcode-api URL, e.g.
# https://alfa-leetcode-api-yrq5.onrender.com
LEETCODE_API_BASE_URL=http://localhost:3001
LEETCODE_USE_STATIC=false
LEETCODE_CACHE_TTL_SECONDS=3600
LEETCODE_USER_CACHE_TTL_SECONDS=600
# Upstream timeout per user request (ms). Higher survives Render cold starts.
LEETCODE_USER_TIMEOUT_MS=30000
