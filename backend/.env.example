PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CACHE_TTL_SECONDS=3600
CF_API_BASE=https://codeforces.com/api
# Production: set this to the deployed alfa-leetcode-api URL, e.g.
# https://alfa-leetcode-api-yrq5.onrender.com
LEETCODE_API_BASE_URL=http://localhost:3001
LEETCODE_USE_STATIC=false
LEETCODE_CACHE_TTL_SECONDS=3600
LEETCODE_USER_CACHE_TTL_SECONDS=600
# Upstream timeout per user request (ms). Higher survives Render cold starts.
LEETCODE_USER_TIMEOUT_MS=30000
# Direct LeetCode GraphQL fallback (used automatically when the alfa instance is down).
# You normally do not need to change these.
LEETCODE_GRAPHQL_URL=https://leetcode.com/graphql
LEETCODE_GRAPHQL_TIMEOUT_MS=20000
# Max time spent on each live source before trying the next / serving the snapshot.
LEETCODE_SOURCE_TIMEOUT_MS=20000
LEETCODE_GRAPHQL_SOURCE_TIMEOUT_MS=35000
# How long the offline snapshot is served before retrying live sources.
LEETCODE_FALLBACK_TTL_SECONDS=300
# Regenerate the bundled full-dataset snapshot:
#   node scripts/update-leetcode-dataset.js

